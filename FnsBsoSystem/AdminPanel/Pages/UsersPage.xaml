<Page x:Class="FnsBsoSystem.AdminPanel.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="UsersPage">

    <Page.Resources>
        <SolidColorBrush x:Key="ColorPrimary" Color="#009CDF"/>
        <!-- Стиль кнопки для блокировки -->
        <Style x:Key="BtnBlock" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="ПОЛЬЗОВАТЕЛИ СИСТЕМЫ" FontSize="24" FontWeight="Bold" Foreground="#333"/>
            <Border Height="3" Width="50" Background="{StaticResource ColorPrimary}" HorizontalAlignment="Left" Margin="0,10,0,30"/>

            <DataGrid x:Name="dgUsers" Height="450" AutoGenerateColumns="False" Background="White" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                    <DataGridTextColumn Header="Активен" Binding="{Binding IsActive}" Width="100"/>
                    <DataGridTemplateColumn Header="Действие" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Блок / Разб." 
                    Click="BtnToggleBlock_Click" 
                    Style="{StaticResource BtnBlock}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>