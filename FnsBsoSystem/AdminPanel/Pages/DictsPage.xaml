<Page x:Class="FnsBsoSystem.AdminPanel.Pages.DictsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DictsPage">

    <Page.Resources>
        <SolidColorBrush x:Key="ColorPrimary" Color="#009CDF"/>
        <Style x:Key="BtnOutlinePill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="20" BorderBrush="{StaticResource ColorPrimary}" BorderThickness="2" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,8"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="СПРАВОЧНИКИ" FontSize="24" FontWeight="Bold" Foreground="#333"/>
            <Border Height="3" Width="50" Background="{StaticResource ColorPrimary}" HorizontalAlignment="Left" Margin="0,10,0,30"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Отделы" Click="LoadDepts" Style="{StaticResource BtnOutlinePill}"/>
                <Button Content="Должности" Click="LoadPos" Style="{StaticResource BtnOutlinePill}" Margin="20,0"/>
                <Button Content="Сохранить" Click="BtnSave_Click" Style="{StaticResource BtnOutlinePill}" Foreground="Green" BorderBrush="Green"/>
            </StackPanel>

            <!-- Явно задаем колонки, чтобы точно отображалось -->
            <DataGrid x:Name="dgDicts" Height="400" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                    <!-- ВАЖНО: убедись, что свойства Name или Title существуют в твоих классах -->
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>